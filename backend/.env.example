# Copy to backend/.env and fill in. Never commit .env.

# Application
APP_ENV=dev               # dev | staging | prod
APP_NAME=anjaneya-ott
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# Database
# For dev: get a free Postgres URL from https://neon.tech (60 seconds, no install)
# Format: postgresql+asyncpg://USER:PASSWORD@HOST/DB
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/anjaneya_ott

# JWT
JWT_SECRET=change-me-to-something-random-and-long
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# CORS — comma-separated origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# First admin bootstrap (creates this user on first startup if no users exist)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me

# Object storage (deferred — placeholder for V1.1)
STORAGE_BUCKET=
STORAGE_REGION=
