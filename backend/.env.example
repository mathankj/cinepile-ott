# Copy to backend/.env and fill in. Never commit .env.

# Application
APP_ENV=dev               # dev | staging | prod
APP_NAME=anjaneya-ott
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# Database
# For dev: get a free Postgres URL from https://neon.tech (60 seconds, no install)
# Format: postgresql+asyncpg://USER:PASSWORD@HOST/DB
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/anjaneya_ott

# JWT
JWT_SECRET=change-me-to-something-random-and-long
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# CORS — comma-separated origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# First admin bootstrap (creates this user on first startup if no users exist)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me

# Object storage — any S3-compatible provider (Backblaze B2, Cloudflare R2,
# AWS S3, Storj, etc.). Leave empty to disable uploads (existing public test
# streams in the seed will continue to play).
# Get B2 keys at: https://secure.backblaze.com → B2 Cloud Storage → Application Keys
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
# Leave empty for PRIVATE buckets (playback signs URLs on-the-fly with 4h TTL).
# Set to a public base URL only if your bucket is configured public.
STORAGE_PUBLIC_URL=
STORAGE_PRESIGNED_TTL_SECONDS=14400

# Razorpay (test or live). Empty = use mock billing provider.
# Test keys: dashboard.razorpay.com → Settings → API Keys → Generate Test Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# auto | mock | razorpay   (auto = razorpay if KEY_ID is set, else mock)
BILLING_PROVIDER=auto
